# Browser API base. Use /api for same-origin deployments or a full HTTPS URL.
VITE_API_URL=/api

# API payload contract. v2 preserves entered KSh amounts and uses unit-labelled meter readings.
VITE_API_CONTRACT=v2

# Vite development proxy target only. This is never bundled into production code.
VITE_DEV_PROXY_TARGET=http://localhost:3000
