# Copy to .env for local configuration. Never commit real secrets.
PORT=3000
NODE_ENV=development
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:5173
# CORS_ORIGINS may be used instead of FRONTEND_ORIGINS.
# DATABASE_URL=file:./data/zenenergies.sqlite
# DB_PATH=./data/zenenergies.sqlite

# Optional first-admin bootstrap. Used only when the users table is empty.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=
# ADMIN_FULL_NAME=Station Administrator

# Set to 1 only when the app is behind a trusted reverse proxy.
TRUST_PROXY=0
LOG_LEVEL=info
